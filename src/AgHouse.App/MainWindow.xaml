<Window x:Class="AgHouse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ws="clr-namespace:AgHouse.App.Workspaces"
        xmlns:app="clr-namespace:AgHouse.App"
        Title="{Binding WindowTitle}"
        Icon="/Assets/aghouse.ico"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- A 2px progress line in neutral brushes: the accent belongs to selection and "Needs you" only. -->
        <Style x:Key="QuietProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="1" HorizontalAlignment="Left"
                                    Background="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The section labels: "Workspaces", "Agents". -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TypeMeta}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- A workspace's letter tile. Its colour comes from the theme's ANSI table (AppTheme.ApplyTiles), picked by name. -->
        <Style x:Key="SpaceTile" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource SpaceTile0Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TileIndex}" Value="1"><Setter Property="Background" Value="{DynamicResource SpaceTile1Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="2"><Setter Property="Background" Value="{DynamicResource SpaceTile2Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="3"><Setter Property="Background" Value="{DynamicResource SpaceTile3Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="4"><Setter Property="Background" Value="{DynamicResource SpaceTile4Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="5"><Setter Property="Background" Value="{DynamicResource SpaceTile5Brush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SpaceTileLetter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SpaceTileInk0Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TileIndex}" Value="1"><Setter Property="Foreground" Value="{DynamicResource SpaceTileInk1Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="2"><Setter Property="Foreground" Value="{DynamicResource SpaceTileInk2Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="3"><Setter Property="Foreground" Value="{DynamicResource SpaceTileInk3Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="4"><Setter Property="Foreground" Value="{DynamicResource SpaceTileInk4Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="5"><Setter Property="Foreground" Value="{DynamicResource SpaceTileInk5Brush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- An agent's glyph wears its workspace's tile colour, so a row in Agents points back to its space. -->
        <Style x:Key="SpaceTileGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SpaceTile0Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TileIndex}" Value="1"><Setter Property="Foreground" Value="{DynamicResource SpaceTile1Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="2"><Setter Property="Foreground" Value="{DynamicResource SpaceTile2Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="3"><Setter Property="Foreground" Value="{DynamicResource SpaceTile3Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="4"><Setter Property="Foreground" Value="{DynamicResource SpaceTile4Brush}" /></DataTrigger>
                <DataTrigger Binding="{Binding TileIndex}" Value="5"><Setter Property="Foreground" Value="{DynamicResource SpaceTile5Brush}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- An agent's mark in the Agents list, picked by AgentRow.AgentKey: the agent's own logo. Claude Code and
             OpenCode are the files the user supplied; the rest are from LobeHub's icon set (MIT,
             github.com/lobehub/lobe-icons; see assets/THIRD-PARTY-NOTICES.md). The logos are their owners'
             trademarks, shown only to say which agent a row is. Claude Code and Amp keep their brand colour; the
             single-colour logos take Primary Text, as SVG currentColor would. Other known agents get a two-letter
             monogram; one known only from reporting in keeps the generic agent glyph in its workspace's tile colour.
             All 14px, from a 24-unit box. -->
        <DataTemplate x:Key="AgentMarkGeneric">
            <TextBlock Text="&#xE99A;" Style="{StaticResource SpaceTileGlyph}" />
        </DataTemplate>
