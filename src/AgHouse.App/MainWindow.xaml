<Window x:Class="AgHouse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ws="clr-namespace:AgHouse.App.Workspaces"
        Title="{Binding WindowTitle}"
        Icon="/Assets/aghouse.ico"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- A 2px progress line in neutral brushes: the accent belongs to selection and "Needs you" only. -->
        <Style x:Key="QuietProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="1" HorizontalAlignment="Left"
                                    Background="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248" MinWidth="170" MaxWidth="480" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───────────── Sidebar ───────────── -->
        <DockPanel Grid.Column="0" Margin="8,4,4,8">

            <Grid DockPanel.Dock="Top" Margin="6,2,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Workspaces" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="1" Click="NewWorkspace_Click" ToolTip="New workspace (Ctrl+Shift+N)"
                        AutomationProperties.Name="New workspace" Padding="8,4" Margin="0,0,2,0">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <Button Grid.Column="2" x:Name="ProfileButton" Click="ProfileMenu_Click" ToolTip="New workspace with…"
                        AutomationProperties.Name="New workspace with a shell" Padding="6,4">
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>
            </Grid>

            <!-- Footer: settings problem > "N waiting" > shortcut hint (WorkspaceController.UpdateFooter). -->
            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- A ghost button: it opens the waiting list (or Settings, for a problem or the setup hint). -->
                <Button x:Name="FooterButton" Click="Footer_Click" Padding="6,4" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        ToolTip="{Binding FooterDetail}" ToolTipService.ShowDuration="30000"
                        AutomationProperties.Name="{Binding FooterText}">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterIcon" DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                               FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               AutomationProperties.Name="Warning">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FooterKind}" Value="Problem">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FooterText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- Secondary, not Tertiary: Tertiary falls under 4.5:1 on light Mica. Waiting steps up to Primary. -->
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FooterKind}" Value="Waiting">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <!-- The one footer state that may wrap: a trimmed command is no use. -->
                                    <DataTrigger Binding="{Binding FooterKind}" Value="Setup">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FooterKind}" Value="Problem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                </Button>
                <Button Grid.Column="1" Click="Settings_Click" ToolTip="Settings (Ctrl+,)"
                        AutomationProperties.Name="Open settings" Padding="8,4"
                        Background="Transparent" BorderThickness="0">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                </Button>
            </Grid>

            <!-- Drag a row to reorder (MainWindow.WorkspaceList_*): a neutral insertion line shows where it lands. -->
            <ListBox x:Name="WorkspaceList"
                     ItemsSource="{Binding Workspaces}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="WorkspaceList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="WorkspaceList_PreviewMouseMove"
                     DragOver="WorkspaceList_DragOver" DragLeave="WorkspaceList_DragLeave" Drop="WorkspaceList_Drop">
                <ListBox.ItemContainerStyle>
                    <!-- WinUI NavigationView-like item: subtle fill on hover/selection plus an accent pill. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,7,8,7" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}" />
                        <!-- Screen readers: the workspace name, its location, and "Needs you: …" while waiting. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Details}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AttentionStatus}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <!-- Level with the name line, not the middle of the row: a busy row is
                                             six lines tall, and the pill should mark the name, not a chip. -->
                                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,9,0,0"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type ws:Workspace}">
                        <Grid Background="Transparent" MouseLeftButtonDown="WorkspaceItem_MouseLeftButtonDown">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename" InputGestureText="Ctrl+Shift+R" Click="Rename_Click" />
                                    <!-- "Ctrl+D", or "Alt+Shift+=" when ctrlDSplits is off (set in WorkspaceController). -->
                                    <MenuItem Header="Split right" InputGestureText="{DynamicResource SplitRightGesture}" Click="SplitRight_Click" />
                                    <MenuItem Header="Split down" InputGestureText="Ctrl+Shift+D" Click="SplitDown_Click" />
                                    <Separator />
                                    <MenuItem Header="Move up" Click="MoveUp_Click" />
                                    <MenuItem Header="Move down" Click="MoveDown_Click" />
                                    <Separator />
                                    <MenuItem Header="Close workspace" InputGestureText="Ctrl+Alt+W" Click="CloseWorkspace_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Attention dot: right edge, on the name line, so it never reads as the left-edge selection pill -->
                            <Grid Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top" Margin="8,5,2,0"
                                  Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Ellipse Margin="-3" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.45" />
                            </Grid>

                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}" />
                                    <TextBox Text="{Binding Name, Mode=OneWay}" Padding="4,1" MinHeight="0"
                                             AutomationProperties.Name="Workspace name"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                                             KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                                </Grid>
                                <!-- "Needs you · message", straight under the name: attention is never pushed down by status lines.
                                     Present only while a pane is still waiting (derived in Workspace.RefreshSummary). -->
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           ToolTip="{Binding WaitingMessages}"
                                           Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                    <Run Text="Needs you" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run
                                         Text="{Binding WaitingSuffix, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <!-- One meta line, git or not, so every idle row is the same height: branch and PR (if any), then location. -->
                                <DockPanel Margin="0,2,0,0">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0"
                                                Visibility="{Binding HasBranch, Converter={StaticResource BoolToVis}}">
                                        <!-- git branch icon -->
                                        <Viewbox Width="11" Height="11" Margin="0,1,5,0" VerticalAlignment="Center">
                                            <Path Width="16" Height="16" StrokeThickness="1.4" Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Data="M4,4.8 L4,11.2 M12,5.8 C12,9 4,8.5 4,11.2 M5.8,3 A1.8,1.8 0 1 1 2.2,3 A1.8,1.8 0 1 1 5.8,3 M5.8,13 A1.8,1.8 0 1 1 2.2,13 A1.8,1.8 0 1 1 5.8,13 M13.8,4 A1.8,1.8 0 1 1 10.2,4 A1.8,1.8 0 1 1 13.8,4" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding Branch}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="96"
                                                   ToolTip="{Binding Branch}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <!-- PR state in words, never in colour: "#123 open", "#123 merged". -->
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding PullRequest}" FontSize="12" Margin="0,0,10,0"
                                               ToolTip="Pull request for this branch (from gh)"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasPullRequest, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Location}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>

                                <!-- Chips: agent state ("Working"), set-status entries, listening ports. Neutral, never the accent. -->
                                <ItemsControl ItemsSource="{Binding Chips}" Margin="0,3,0,0" Focusable="False"
                                              Visibility="{Binding HasChips, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ws:SidebarChip}">
                                            <Border x:Name="Chip" CornerRadius="3" BorderThickness="1" Padding="5,0,5,1" Margin="0,2,4,0"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    ToolTip="{Binding ToolTip}" MouseLeftButtonUp="Chip_MouseLeftButtonUp">
                                                <TextBlock Text="{Binding Text}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <!-- A port opens in the browser, so it looks clickable on hover. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Port, Converter={StaticResource IsNotNull}}" Value="True" />
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=Chip}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    <Setter TargetName="Chip" Property="Cursor" Value="Hand" />
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Progress from `aghouse set-progress`: a caption, then a 2px neutral bar the width of the row. -->
                                <StackPanel Margin="0,5,0,0" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ProgressText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,3,0,0"
                                                 Style="{StaticResource QuietProgress}"
                                                 AutomationProperties.Name="{Binding ProgressText}" />
                                </StackPanel>

                                <!-- Newest `aghouse log` line; warn/error get the caution glyph, like a settings problem. -->
                                <DockPanel Margin="0,4,0,0" ToolTip="{Binding LogHistory}"
                                           Visibility="{Binding HasLog, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Margin="0,1,5,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               AutomationProperties.Name="Warning"
                                               Visibility="{Binding LastLogIsProblem, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding LastLog}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeBehavior="PreviousAndNext" DragCompleted="SidebarSplitter_DragCompleted"
                      HorizontalAlignment="Stretch" Focusable="False" />

        <!-- ───────────── Terminals: one WorkspaceView per workspace, only the selected one visible ───────────── -->
        <Grid x:Name="WorkspaceHost" Grid.Column="2" Margin="2,4,8,8" />
    </Grid>
</Window>
