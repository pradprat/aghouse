        <DataTemplate x:Key="AgentMarkMonogram">
            <Border Width="16" Height="16" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}">
                <TextBlock Text="{Binding Monogram}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Border>
        </DataTemplate>
        <Style x:Key="AgentMark" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="ContentTemplate" Value="{StaticResource AgentMarkMonogram}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AgentKey}" Value="{x:Null}"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkGeneric}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="claude"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkClaude}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="opencode"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkOpenCode}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="codex"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkCodex}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="gemini"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkGemini}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="copilot"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkCopilot}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="cursor-agent"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkCursor}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="goose"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkGoose}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="kiro-cli"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkKiro}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="qwen"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkQwen}" /></DataTrigger>
                <DataTrigger Binding="{Binding AgentKey}" Value="amp"><Setter Property="ContentTemplate" Value="{StaticResource AgentMarkAmp}" /></DataTrigger>
                <!-- Every agent the same program (AgentRow.MarkQuiet): the brand-coloured marks step down to Secondary Text. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding AgentKey}" Value="claude" />
                        <Condition Binding="{Binding MarkQuiet}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContentTemplate" Value="{StaticResource AgentMarkClaudeQuiet}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding AgentKey}" Value="amp" />
                        <Condition Binding="{Binding MarkQuiet}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContentTemplate" Value="{StaticResource AgentMarkAmpQuiet}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shown while the sidebar is open; collapsed on the rail (Ctrl+Shift+B). -->
        <Style x:Key="OpenOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="248" MinWidth="170" MaxWidth="480" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ───────────── Sidebar: header, Workspaces, Agents, then the slack, then the footer ───────────── -->
        <!-- The workspace list is as tall as its rows (up to what's left: MainWindow.FitWorkspaceList) and Agents sits
             right under it, so a short list doesn't strand Agents at the bottom behind an empty band. -->
        <Grid x:Name="Sidebar" Grid.Column="0" Margin="8,4,4,8" SizeChanged="Sidebar_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: "Workspaces", then search (the command palette), its menu (shells, grouping), + and fold.
                 No mark or name here: the system title bar already carries both. -->
            <DockPanel x:Name="HeaderBar" Grid.Row="0" Margin="6,2,0,6">
                <Button DockPanel.Dock="Right" x:Name="FoldButton" Style="{StaticResource Ghost}" Click="FoldSidebar_Click" ToolTip="Fold the sidebar (Ctrl+Shift+B)"
                        AutomationProperties.Name="Fold the sidebar">
                    <TextBlock x:Name="FoldGlyph" Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="NewWorkspace_Click" Padding="6,5" Margin="0,0,2,0"
                        ToolTip="New workspace (Ctrl+Shift+N)" AutomationProperties.Name="New workspace"
                        Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <Button DockPanel.Dock="Right" x:Name="SpacesMenuButton" Style="{StaticResource Ghost}" Click="SpacesMenu_Click" Padding="6,5"
                        Margin="0,0,2,0" ToolTip="New workspace with a shell, grouping" AutomationProperties.Name="Workspaces menu"
                        Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Search_Click" Margin="0,0,2,0"
                        ToolTip="Search actions, workspaces and panes (Ctrl+Shift+P)" AutomationProperties.Name="Search"
                        Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>
                <TextBlock Text="Workspaces" Style="{StaticResource SectionLabel}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
            </DockPanel>

            <!-- On the rail the header has room for fold only, so + gets its own row under it. -->
            <Button x:Name="RailNewButton" Grid.Row="1" Style="{StaticResource Ghost}" Click="NewWorkspace_Click" Padding="6,5"
                    HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"
                    ToolTip="New workspace (Ctrl+Shift+N)" AutomationProperties.Name="New workspace">
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" />
            </Button>

            <!-- Drag a row to reorder (MainWindow.WorkspaceList_*): a neutral insertion line shows where it lands. -->
            <ListBox x:Name="WorkspaceList" Grid.Row="2"
                     ItemsSource="{Binding Workspaces}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="WorkspaceList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="WorkspaceList_PreviewMouseMove"
                     DragOver="WorkspaceList_DragOver" DragLeave="WorkspaceList_DragLeave" Drop="WorkspaceList_Drop">
                <!-- Grouped by project (only while MainWindow.ApplyGrouping adds a group description). Each
                     group's Name is its SidebarGroup. The header toggles; collapsed, it still says what it hides
                     needs you (dot + "N waiting"), and carries the selection pill if the selected row is inside. -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <!-- The group says "repoB, 2 workspaces, 1 waiting". Its body is an Expander (re-templated to
                                     the quiet header below) because WPF's group peer finds one in the template and then
                                     offers expand/collapse to screen readers; with a bare ToggleButton it exposed only the rows. -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name.Summary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <!-- No gap around a lone row (a project with one workspace): it spaces like any row.
                                                 A project with a header gets 4px above and below, so it reads as one block. -->
                                            <Expander x:Name="Block" Margin="0" Padding="0" BorderThickness="0" Background="Transparent"
                                                      IsExpanded="{Binding Name.ShowsRows, Mode=TwoWay, FallbackValue=True}">
                                            <Expander.Template>
                                            <ControlTemplate TargetType="Expander">
                                            <StackPanel>
                                                <ToggleButton x:Name="Header"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              Padding="0" Margin="0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                              FocusVisualStyle="{StaticResource RowFocusVisual}"
                                                              ToolTip="{Binding Name.Label}"
                                                              AutomationProperties.Name="{Binding Name.Summary}">
                                                    <ToggleButton.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Collapse all" Click="CollapseAllGroups_Click" />
                                                            <MenuItem Header="Expand all" Click="ExpandAllGroups_Click" />
                                                            <Separator />
                                                            <MenuItem Header="Show as a list" Click="Ungroup_Click" />
                                                        </ContextMenu>
                                                    </ToggleButton.ContextMenu>
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Grid>
                                                                <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="6,4,8,4">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <Border x:Name="Pill" app:Motion.Entrance="Pill" Width="3" Height="16" CornerRadius="1.5"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                </Trigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Name.RowsHidden}" Value="True" />
                                                                        <Condition Binding="{Binding Name.ContainsSelected}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                </MultiDataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                    <DockPanel>
                                                        <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="9" Width="10" Margin="2,0,8,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <!-- The attention dot, as on a row: only while collapsed (expanded, the rows show their own). -->
                                                        <Grid DockPanel.Dock="Right" Width="10" Height="10" Margin="8,0,2,0" VerticalAlignment="Center"
                                                              Visibility="{Binding Name.ShowsWaiting, Converter={StaticResource BoolToVis}}">
                                                            <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" app:Motion.Entrance="Dot" />
                                                            <Ellipse Margin="-3" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.45" app:Motion.Entrance="Halo" />
                                                        </Grid>
                                                        <TextBlock x:Name="Note" DockPanel.Dock="Right" Text="{Binding Name.Note}" FontSize="{DynamicResource TypeCaption}" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource TypeMeta}">
                                                            <Run Text="{Binding Name.Label, Mode=OneWay}" FontWeight="SemiBold"
                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run
                                                                 Text="  " /><Run Text="{Binding Name.Count, Mode=OneWay}"
                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="Rows" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <!-- Bound to Name.ShowsRows: false only for a collapsed group that has a header. -->
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                                </Trigger>
                                                <!-- A project with one workspace is just its row: the header would only repeat its name. -->
                                                <DataTrigger Binding="{Binding Name.HasHeader}" Value="False">
                                                    <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name.ShowsWaiting}" Value="True">
                                                    <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <Setter TargetName="Note" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <!-- Rows whose project isn't known yet (the first moment after launch): no header. -->
                                                <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
                                                    <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!-- The rail has no room for headers: every tile shows, whatever is collapsed. -->
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Rows" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                            </Expander.Template>
                                                <ItemsPresenter />
                                            </Expander>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Name.HasHeader}" Value="True">
                                                    <Setter TargetName="Block" Property="Margin" Value="0,4,0,4" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <!-- One compact row: subtle fill on hover/selection plus the accent pill, level with the tile. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,6,8,6" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}" />
                        <!-- Screen readers: the workspace name, its location, and "Needs you: …" while waiting. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Details}" />
                        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AttentionStatus}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <!-- Level with the tile, not the middle of the row: a waiting row is two or three lines. -->
                                        <Border x:Name="Pill" app:Motion.Entrance="Pill" Width="3" Height="16" CornerRadius="1.5"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- The rail: the tile alone, centred in the 40px column. -->
                            <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Padding" Value="10,6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type ws:Workspace}">
                        <Grid Background="Transparent" MouseLeftButtonDown="WorkspaceItem_MouseLeftButtonDown"
                              ToolTip="{Binding RowToolTip}" ToolTipService.InitialShowDelay="700">
                            <Grid.ContextMenu>
                                <ContextMenu Opened="RowMenu_Opened">
                                    <MenuItem Header="Rename" InputGestureText="Ctrl+Shift+R" Click="Rename_Click" />
                                    <!-- "Ctrl+D", or "Alt+Shift+=" when ctrlDSplits is off (set in WorkspaceController). -->
                                    <MenuItem Header="Split right" InputGestureText="{DynamicResource SplitRightGesture}" Click="SplitRight_Click" />
                                    <MenuItem Header="Split down" InputGestureText="Ctrl+Shift+D" Click="SplitDown_Click" />
                                    <Separator />
                                    <MenuItem Header="Move up" Click="MoveUp_Click" />
                                    <MenuItem Header="Move down" Click="MoveDown_Click" />
                                    <Separator />
                                    <MenuItem Header="Close workspace" InputGestureText="Ctrl+Alt+W" Click="CloseWorkspace_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The tile, with the attention dot on its corner while the sidebar is a rail. -->
                            <Grid Grid.Column="0" VerticalAlignment="Top">
                                <Border Style="{StaticResource SpaceTile}">
                                    <TextBlock Text="{Binding TileLetter}" Style="{StaticResource SpaceTileLetter}" />
                                </Border>
                                <Grid Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasUnread}" Value="True" />
                                                        <Condition Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <!-- No resting halo on the rail (the tile is busy enough): the ring shows only as it ripples. -->
                                    <Ellipse Margin="-3" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0"
                                             app:Motion.PulseSince="{Binding WaitingSince}" app:Motion.Entrance="Halo" />
                                    <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" app:Motion.Entrance="Dot"
                                             Stroke="{DynamicResource ApplicationBackgroundBrush}" StrokeThickness="1.5" />
                                </Grid>
                            </Grid>

                            <!-- Name, branch and dot share the first line. The name is the row's identity, so it takes the
                                 room it needs first (DockPanel measures in order) and the branch trims into what's left. -->
                            <DockPanel Grid.Column="1" Grid.ColumnSpan="3" Margin="10,0,0,0" VerticalAlignment="Center" LastChildFill="True"
                                       Style="{StaticResource OpenOnly}">
                            <!-- Attention dot: right edge, level with the name, so it never reads as the left-edge pill. -->
                            <Grid DockPanel.Dock="Right" Width="10" Height="10" VerticalAlignment="Center" Margin="10,0,2,0">
                                <Grid.Style>
                                    <Style TargetType="Grid" BasedOn="{StaticResource OpenOnly}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnread}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" app:Motion.Entrance="Dot" />
                                <Ellipse Margin="-3" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.45"
                                         app:Motion.PulseSince="{Binding WaitingSince}" app:Motion.Entrance="Halo" />
                            </Grid>

                            <Grid DockPanel.Dock="Left" Style="{StaticResource OpenOnly}">
                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource TypeRow}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBox Text="{Binding Name, Mode=OneWay}" Padding="4,1" MinHeight="0" MinWidth="120"
                                         AutomationProperties.Name="Workspace name"
                                         Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                         IsVisibleChanged="RenameBox_IsVisibleChanged"
                                         KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                            </Grid>

                            <!-- The branch, after the name, unless it's main or master (then it's in the tooltip only). -->
                            <TextBlock Text="{Binding Branch}" FontSize="{DynamicResource TypeMeta}" Margin="10,0,0,0" MaxWidth="110" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OpenOnly}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowsBranch}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </DockPanel>

                            <!-- "Needs you · message", under the name. Present only while a pane is still waiting (derived in
                                 Workspace.RefreshSummary). It may wrap onto a second line and trims after that. -->
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" FontSize="{DynamicResource TypeMeta}" TextTrimming="CharacterEllipsis" Margin="10,3,0,0"
                                       TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="{DynamicResource TypeMetaLine}" MaxHeight="{DynamicResource TypeMetaTwoLines}"
                                       ToolTip="{Binding WaitingMessages}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OpenOnly}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnread}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="Needs you" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run
                                     Text="{Binding WaitingSuffix, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>

                            <!-- Progress from `aghouse set-progress`: a 2px neutral line under the row; the tooltip has the label. -->
                            <ProgressBar Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,6,0,0"
                                         Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"
                                         AutomationProperties.Name="{Binding ProgressText}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource QuietProgress}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasProgress}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ───── Agents: every agent that reported in or runs a known agent program, under Needs you / Working / Idle (WorkspaceController.Agents) ───── -->
            <StackPanel x:Name="AgentsPanel" Grid.Row="3" Style="{StaticResource OpenOnly}" SizeChanged="SidebarBand_SizeChanged">
                <Border Height="1" Margin="0,8,0,10" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <DockPanel Margin="6,0,0,2">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="AgentsHistory_Click" Padding="6,5"
                            ToolTip="Waiting list and earlier requests (Ctrl+Shift+I)" AutomationProperties.Name="Waiting list">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                    <TextBlock Text="Agents" Style="{StaticResource SectionLabel}" />
                </DockPanel>
                <TextBlock Text="No agents running. Start Claude Code, Codex or OpenCode in a pane and it shows up here."
                           FontSize="{DynamicResource TypeMeta}" TextWrapping="Wrap" Margin="6,4,6,4"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasAgents, Converter={StaticResource InverseBoolToVis}}" />
                <ScrollViewer x:Name="AgentsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding AgentItems}" Focusable="False">
                        <ItemsControl.Resources>
                            <!-- "Idle  3": the state in words, then how many. -->
                            <DataTemplate DataType="{x:Type ws:AgentGroupHeader}">
                                <TextBlock Margin="6,8,0,3" FontSize="{DynamicResource TypeMeta}" AutomationProperties.Name="{Binding Summary}">
                                    <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run
                                         Text="  " /><Run Text="{Binding Count, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </DataTemplate>
                            <!-- One agent: its mark, "task · workspace" (for one that needs you, "request · workspace",
                                 the same words as its workspace row), wrapping onto a second line before it trims; then
                                 its age and its state mark, level with the first line. -->
                            <DataTemplate DataType="{x:Type ws:AgentRow}">
                                <Button Style="{StaticResource Ghost}" Click="AgentRow_Click" Padding="6,4" Margin="0,1"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding AutomationName}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Style="{StaticResource AgentMark}" Margin="0,1,8,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" FontSize="{DynamicResource TypeMeta}" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                                                   TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="{DynamicResource TypeMetaLine}" MaxHeight="{DynamicResource TypeMetaTwoLines}">
                                            <Run Text="{Binding Headline, Mode=OneWay}" /><Run
                                                 Text="{Binding Context, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="{DynamicResource TypeCaption}" Margin="8,1,0,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <!-- Needs you: the accent dot (the group heading says it in words), its halo at rest: the
                                             workspace row above pulses for the same request, once is enough. Working: a filled
                                             neutral dot. Idle: a hollow ring. -->
                                        <Grid Grid.Column="3" Width="10" Height="10" Margin="10,3,2,0" VerticalAlignment="Top">
                                            <Grid Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}">
                                                <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}" app:Motion.Entrance="Dot" />
                                                <Ellipse Margin="-3" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="1" Opacity="0.45" />
                                            </Grid>
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                     Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                                            <Ellipse Width="9" Height="9" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.2"
                                                     Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- ───── Footer: the status line (settings problem > "N waiting" > new version > setup > hint), then Settings ───── -->
            <StackPanel x:Name="FooterPanel" Grid.Row="5" Margin="0,8,0,0" SizeChanged="SidebarBand_SizeChanged">
                <Border Height="1" Margin="0,0,0,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <!-- A ghost button: it opens the waiting list (or Settings, for a problem or the setup hint). -->
                <Button x:Name="FooterButton" Click="Footer_Click" Padding="6,4" Margin="0,0,0,2"
                        HorizontalContentAlignment="Stretch"
                        ToolTip="{Binding FooterDetail}" ToolTipService.ShowDuration="30000"
                        AutomationProperties.Name="{Binding FooterText}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Ghost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterIcon" DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                               FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               AutomationProperties.Name="Warning">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FooterKind}" Value="Problem">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FooterText}" FontSize="{DynamicResource TypeCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- Secondary, not Tertiary: Tertiary falls under 4.5:1 on light Mica. Waiting steps up to Primary. -->
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FooterKind}" Value="Waiting">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                    <!-- The one footer state that may wrap: a trimmed command is no use. -->
                                    <DataTrigger Binding="{Binding FooterKind}" Value="Setup">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FooterKind}" Value="Problem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                </Button>
                <!-- Settings: the gear and its name; on the rail, the gear alone. -->
                <Button x:Name="SettingsButton" Style="{StaticResource Ghost}" Click="Settings_Click" Padding="6,5"
                        HorizontalContentAlignment="Left" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Open settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Settings" FontSize="{DynamicResource TypeRow}" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource OpenOnly}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" Background="Transparent" ResizeBehavior="PreviousAndNext"
                      DragCompleted="SidebarSplitter_DragCompleted" HorizontalAlignment="Stretch" Focusable="False" />

        <!-- ───────────── Terminals: one WorkspaceView per workspace, only the selected one visible ───────────── -->
        <Grid x:Name="WorkspaceHost" Grid.Column="2" Margin="2,4,8,8" />
    </Grid>
</Window>
