<Application x:Class="AgHouse.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AgHouse.App"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:IsNotNullConverter x:Key="IsNotNull" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- The type ramp. These are the sizes at 100%: Typography.Apply scales them (and Fluent's own control
             text) by Windows' Settings › Accessibility › Text size, so bind text to them with DynamicResource.
             Icons, tile letters and the Settings preview drawings keep fixed sizes, as Windows' own icons do. -->
        <sys:Double x:Key="TypeCaption">11</sys:Double>
        <sys:Double x:Key="TypeMeta">12</sys:Double>
        <sys:Double x:Key="TypeRow">13</sys:Double>
        <sys:Double x:Key="TypeBody">14</sys:Double>
        <sys:Double x:Key="TypeTitle">20</sys:Double>
        <!-- Meta text that wraps onto a second line and trims after it: one line's height, and two. -->
        <sys:Double x:Key="TypeMetaLine">16</sys:Double>
        <sys:Double x:Key="TypeMetaTwoLines">32</sys:Double>

        <!-- Fluent's two-stroke keyboard focus ring on a 4px row. Shows only for keyboard focus; never the accent. -->
        <Style x:Key="RowFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border CornerRadius="4" BorderThickness="2" SnapsToDevicePixels="True"
                                BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}">
                            <Border CornerRadius="2" BorderThickness="1"
                                    BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ghost button (every sidebar control, and the pane header's ✕ and +): transparent at rest, the
             subtle fill on hover. Icons rest in Secondary Text. -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows in the palette, waiting list and find results: compact, and the selected row takes the
             subtle fill, never the accent (the accent means only "selected workspace" and "Needs you"). -->
        <Style x:Key="QuietListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
