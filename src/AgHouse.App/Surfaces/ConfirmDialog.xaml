<Window x:Class="AgHouse.App.Surfaces.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:AgHouse.App.Surfaces"
        Title="aghouse" Icon="/AgHouseApp;component/Assets/aghouse.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- WinUI's ContentDialog shape in a real owned window: the question, what it costs, then a
         footer band of two equal buttons. Every colour is a Fluent brush; the accent is never used,
         because the action ends running work and must not look like the inviting choice. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource LayerFillColorAltBrush}" Padding="24,20,24,24">
            <StackPanel>
                <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Body" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap" />

                <ItemsControl x:Name="Items" Margin="0,14,0,0" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type s:ConfirmItem}">
                            <Grid Margin="0,6,0,0" ToolTip="{Binding Name}"
                                  AutomationProperties.Name="{Binding Spoken}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Where}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Needs you: words at full weight. Working: the sidebar's neutral chip. -->
                                <TextBlock Grid.Column="1" Text="Needs you" FontSize="12" FontWeight="SemiBold"
                                           Margin="16,2,0,0" VerticalAlignment="Top"
                                           Visibility="{Binding NeedsYou, Converter={StaticResource BoolToVis}}" />
                                <Border Grid.Column="1" CornerRadius="3" BorderThickness="1" Padding="5,0,5,1"
                                        Margin="16,2,0,0" VerticalAlignment="Top"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding State}" FontSize="11" MaxWidth="120" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="More" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Footer band over plain Mica, set off by a hairline, as in ContentDialog. -->
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ConfirmButton" HorizontalAlignment="Stretch" Click="Confirm_Click" />
                <!-- Cancel is the default: Enter and Esc both keep the work running. -->
                <Button x:Name="CancelButton" Grid.Column="2" Content="_Cancel" HorizontalAlignment="Stretch"
                        IsDefault="True" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
