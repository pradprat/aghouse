<Window x:Class="AgHouse.App.Surfaces.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:AgHouse.App"
        Title="aghouse settings" Icon="/Assets/aghouse.ico"
        Width="780" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Nav rows: the sidebar's own NavigationView look (subtle fill, accent pill on the selected page). -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8,10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pill" app:Motion.Entrance="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Links stay neutral and underlined: the accent marks only selection and "Needs you". -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <!-- WinUI's subtitle step (20/600), as in the confirmation dialog's heading: a page title has to
             outrank the 14px row labels under it, and at 14/600 it barely did. -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TypeTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TypeBody}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource TypeMeta}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- One setting: words on the left, the control on the right, a hairline under it. -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="0,12" />
        </Style>

        <!-- A theme in a picker: a strip of its terminal background with six ANSI colours and its accent, then the name.
             These colours are the scheme's own (data, like the terminal palette), not chrome. -->
        <DataTemplate x:Key="ThemeItem">
            <StackPanel Orientation="Horizontal">
                <Border Height="16" CornerRadius="3" BorderThickness="1" Padding="4,0" Margin="0,0,10,0" VerticalAlignment="Center"
                        Background="{Binding TerminalBackground}" BorderBrush="{Binding Stroke}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="6" Height="6" RadiusX="1" RadiusY="1" Margin="0,0,2,0" Fill="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Ellipse Width="8" Height="8" Margin="3,0,0,0" Fill="{Binding Accent}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Note}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- A small drawing of aghouse in a theme: the sidebar with the selected workspace's pill, and a pane
             that needs you (accent frame plus the words) running a few lines in the scheme's colours. -->
        <DataTemplate x:Key="ThemePreview">
            <Border CornerRadius="6" BorderThickness="1" Background="{Binding Surface}" BorderBrush="{Binding Stroke}"
                    Height="128" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="6,8,4,6" TextElement.FontSize="11">
                        <Grid Margin="0,0,0,2">
                            <Border CornerRadius="3" Background="{Binding Subtle}" Padding="8,3,4,3">
                                <TextBlock Text="api" Foreground="{Binding Ink}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Width="3" Height="10" CornerRadius="1.5" HorizontalAlignment="Left" Background="{Binding Accent}" />
                        </Grid>
                        <DockPanel Margin="8,3,4,0">
                            <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="{Binding Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="docs" Foreground="{Binding Ink}" />
                        </DockPanel>
                        <TextBlock Margin="8,1,4,0" Text="Needs you" FontSize="10" Foreground="{Binding Secondary}" />
                        <TextBlock Margin="8,5,4,0" Text="web" Foreground="{Binding Ink}" />
                    </StackPanel>
                    <Border Grid.Column="1" Margin="2,6,6,6" CornerRadius="3" BorderThickness="2"
                            BorderBrush="{Binding Accent}" Background="{Binding TerminalBackground}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="6,2,6,0" FontSize="10" Text="Needs you" Foreground="{Binding Ink}" />
                            <StackPanel Margin="6,3,4,4" TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="10">
                                <TextBlock>
                                    <Run Text="~/docs" Foreground="{Binding Cyan}" /><Run Text=" main" Foreground="{Binding Purple}" /><Run Text=" $ npm test" Foreground="{Binding TerminalForeground}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="PASS" Foreground="{Binding Green}" /><Run Text=" links.test.js" Foreground="{Binding TerminalForeground}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="FAIL" Foreground="{Binding Red}" /><Run Text=" build.test.js" Foreground="{Binding TerminalForeground}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="warn" Foreground="{Binding Yellow}" /><Run Text=" 2 slow tests" Foreground="{Binding TerminalForeground}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Allow edit?" Foreground="{Binding Blue}" /><Run Text=" (y/n)" Foreground="{Binding TerminalForeground}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- settings.json can't be read: the same caution glyph and words as the sidebar footer, as a Fluent InfoBar. -->
        <Border x:Name="ProblemBar" DockPanel.Dock="Top" Margin="12,12,12,0" Padding="12,10" CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,12,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <Button DockPanel.Dock="Right" Content="Edit settings.json" Click="EditJson_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock x:Name="ProblemTitle" FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProblemDetail" Style="{StaticResource Help}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Nav" Margin="8,12,4,8" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                     AutomationProperties.Name="Settings pages">
                <ListBoxItem Tag="General" AutomationProperties.Name="General">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="General" FontSize="{DynamicResource TypeBody}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Appearance" AutomationProperties.Name="Appearance">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="Appearance" FontSize="{DynamicResource TypeBody}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Notifications" AutomationProperties.Name="Notifications">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="Notifications" FontSize="{DynamicResource TypeBody}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Integrations" AutomationProperties.Name="Integrations">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="Integrations" FontSize="{DynamicResource TypeBody}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="About" AutomationProperties.Name="About">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="About" FontSize="{DynamicResource TypeBody}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16,24,24">
                <!-- Every page fills one column (up to 640px, left-aligned), so the controls on the right share
                     one edge whichever page shows. Sized to its content, each page had its own edge. -->
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="640" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>

                    <!-- ───────── General ───────── -->
                    <StackPanel x:Name="GeneralPage">
                        <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="DefaultShell" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                          DisplayMemberPath="Name" SelectionChanged="Changed" AutomationProperties.Name="Default shell" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Default shell" Style="{StaticResource Label}" />
                                    <TextBlock Text="New workspaces start in it. The menu next to + opens one in any other shell." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="CtrlDSplits" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Ctrl+D splits right" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Ctrl+D splits right" Style="{StaticResource Label}" />
                                    <TextBlock Text="Turn it off to give Ctrl+D back to the terminal, where it ends input or exits. Alt+Shift+= still splits right." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="GroupWorkspaces" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Group workspaces by project" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Group workspaces by project" Style="{StaticResource Label}" />
                                    <TextBlock Text="The sidebar puts workspaces in the same git repo (worktrees included) or folder under one header you can collapse. The button next to Workspaces does the same." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="RestoreSession" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Reopen workspaces at launch" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Reopen workspaces at launch" Style="{StaticResource Label}" />
                                    <TextBlock Text="Layout, tabs and folders come back. Running programs and scrollback don't." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="WarnMultilinePaste" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Ask before pasting lines that would run" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Ask before pasting lines that would run" Style="{StaticResource Label}" />
                                    <TextBlock Text="When the clipboard holds a line break and the shell would run each line as it arrives. Copied text can hide one." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───────── Appearance ───────── -->
                    <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                        <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="ThemeChoice" DockPanel.Dock="Right" MinWidth="240" VerticalAlignment="Center"
                                          SelectionChanged="Changed" AutomationProperties.Name="Mode">
                                    <ComboBoxItem Tag="system" Content="Use Windows setting" />
                                    <ComboBoxItem Tag="dark" Content="Dark" />
                                    <ComboBoxItem Tag="light" Content="Light" />
                                </ComboBox>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Mode" Style="{StaticResource Label}" />
                                    <TextBlock Text="Which of the two themes below shows. The window and the terminals change together." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="DarkThemeChoice" DockPanel.Dock="Right" MinWidth="240" VerticalAlignment="Center"
                                          ItemTemplate="{StaticResource ThemeItem}" MaxDropDownHeight="420"
                                          SelectionChanged="Changed" AutomationProperties.Name="Dark theme" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Dark theme" Style="{StaticResource Label}" />
                                    <TextBlock Text="Windows keeps Mica and your accent colour. Any other theme colours the whole window and its accent marks “Needs you”." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="LightThemeChoice" DockPanel.Dock="Right" MinWidth="240" VerticalAlignment="Center"
                                          ItemTemplate="{StaticResource ThemeItem}" MaxDropDownHeight="420"
                                          SelectionChanged="Changed" AutomationProperties.Name="Light theme" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Light theme" Style="{StaticResource Label}" />
                                    <TextBlock Text="Shows when Windows is in light mode, or when Mode is Light." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <ContentControl x:Name="DarkPreview" ContentTemplate="{StaticResource ThemePreview}" Focusable="False"
                                                        AutomationProperties.Name="Dark theme preview" />
                                        <TextBlock x:Name="DarkPreviewLabel" Style="{StaticResource Help}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <ContentControl x:Name="LightPreview" ContentTemplate="{StaticResource ThemePreview}" Focusable="False"
                                                        AutomationProperties.Name="Light theme preview" />
                                        <TextBlock x:Name="LightPreviewLabel" Style="{StaticResource Help}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                                <!-- Custom schemes in settings.json that can't be used: named, with what's wrong. -->
                                <DockPanel x:Name="SchemeProblems" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,8,0"
                                               VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock x:Name="SchemeProblemsText" Style="{StaticResource Help}" Margin="0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button x:Name="ImportThemes" DockPanel.Dock="Right" Content="Import" MinWidth="96" VerticalAlignment="Center"
                                        Click="ImportThemes_Click" AutomationProperties.Name="Import from Windows Terminal" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Import from Windows Terminal" Style="{StaticResource Label}" />
                                    <TextBlock Text="Copies its colour schemes into aghouse's settings.json, where you can also add your own. Later changes in Windows Terminal don't carry over." Style="{StaticResource Help}" />
                                    <TextBlock x:Name="ImportResult" Style="{StaticResource Help}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Margin="0,6,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="FontChoice" DockPanel.Dock="Right" MinWidth="240" VerticalAlignment="Center"
                                          SelectionChanged="Changed" AutomationProperties.Name="Terminal font" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Terminal font" Style="{StaticResource Label}" />
                                    <TextBlock Text="The monospaced fonts installed on this PC." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="SizeChoice" DockPanel.Dock="Right" MinWidth="240" VerticalAlignment="Center"
                                          SelectionChanged="Changed" AutomationProperties.Name="Text size in points" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Text size" Style="{StaticResource Label}" />
                                    <TextBlock Text="In points. Ctrl+= and Ctrl+- change one pane for now; Ctrl+0 puts it back to this." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───────── Notifications ───────── -->
                    <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
                        <TextBlock Text="Notifications" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,4"
                                   Text="Inside the window, a pane that needs you always gets the accent ring and the words “Needs you”. These settings are for when aghouse is behind other windows." />
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="Toasts" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Show a Windows notification" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Show a Windows notification" Style="{StaticResource Label}" />
                                    <TextBlock Text="With the agent's message. Clicking it goes to the pane." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="FlashTaskbar" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Flash the taskbar button" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Flash the taskbar button" Style="{StaticResource Label}" />
                                    <TextBlock Text="Until you switch back to aghouse." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───────── Integrations ───────── -->
                    <StackPanel x:Name="IntegrationsPage" Visibility="Collapsed">
                        <TextBlock Text="Integrations" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button x:Name="ConnectClaude" DockPanel.Dock="Right" Content="Connect Claude Code" VerticalAlignment="Center"
                                        Click="ConnectClaude_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Claude Code" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="ClaudeStatus" Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button x:Name="ConnectOpenCode" DockPanel.Dock="Right" Content="Connect OpenCode" VerticalAlignment="Center"
                                        Click="ConnectOpenCode_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="OpenCode" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="OpenCodeStatus" Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="Other agents and scripts" Style="{StaticResource Label}" />
                                <TextBlock Style="{StaticResource Help}">
                                    <Run Text="From any pane, run " /><Run Text="aghouse notify --body &quot;Waiting for approval&quot;" FontFamily="Cascadia Mono, Consolas" /><Run
                                         Text=", or print an OSC 9 or OSC 777 notification. A bell marks the pane too. Add " /><Run Text="--finished" FontFamily="Cascadia Mono, Consolas" /><Run Text=" when the work is done rather than waiting on an answer: it then waits behind panes that are asking. Scripts can also fill the sidebar with " /><Run
                                         Text="aghouse set-status" FontFamily="Cascadia Mono, Consolas" /><Run Text=", " /><Run
                                         Text="set-progress" FontFamily="Cascadia Mono, Consolas" /><Run Text=" and " /><Run
                                         Text="log" FontFamily="Cascadia Mono, Consolas" /><Run Text="." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───────── About ───────── -->
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                        <DockPanel Margin="0,8,0,12">
                            <Image Source="/Assets/aghouse-128.png" Width="48" Height="48" Margin="0,0,14,0" DockPanel.Dock="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="aghouse logo" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="aghouse" FontSize="{DynamicResource TypeBody}" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionLabel" Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,12"
                                   Text="A Windows-native terminal workspace for running coding agents side by side." />
                        <!-- Updates: what the last check found, and what to do about it. Neutral buttons: the accent stays for selection and "Needs you". -->
                        <Border Style="{StaticResource Row}" BorderThickness="0,1,0,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="UpdateNow" Click="UpdateNow_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                                    <Button x:Name="CheckUpdates" Content="Check for updates" Click="CheckUpdates_Click" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Help}" />
                                    <TextBlock x:Name="WhatsNew" Style="{StaticResource Help}" Visibility="Collapsed">
                                        <Hyperlink x:Name="WhatsNewLink" RequestNavigate="Link_RequestNavigate">What's new</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="UpdatesChoice" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                          SelectionChanged="Changed" AutomationProperties.Name="Install updates">
                                    <ComboBoxItem Tag="auto" Content="Automatically" />
                                    <ComboBoxItem Tag="notify" Content="Ask me first" />
                                    <ComboBoxItem Tag="off" Content="Don't check" />
                                </ComboBox>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Install updates" Style="{StaticResource Label}" />
                                    <TextBlock Style="{StaticResource Help}"
                                               Text="aghouse asks GitHub for a new version every few hours. Automatically: it downloads in the background and installs when you quit aghouse, so nothing running is cut short." />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}">
                                    <Hyperlink NavigateUri="https://github.com/pradprat/aghouse" RequestNavigate="Link_RequestNavigate">Source code on GitHub</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Label}" Margin="0,6,0,0">
                                    <Hyperlink NavigateUri="https://github.com/pradprat/aghouse/releases" RequestNavigate="Link_RequestNavigate">Releases</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0" Text="MIT License" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Open the logs folder" Click="Logs_Click" Margin="0,0,8,0" />
                            <Button Content="Edit settings.json" Click="EditJson_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
