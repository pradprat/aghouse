<Window x:Class="AgHouse.App.Surfaces.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="aghouse settings" Icon="/Assets/aghouse.ico"
        Width="780" Height="600" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Nav rows: the sidebar's own NavigationView look (subtle fill, accent pill on the selected page). -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8,10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Links stay neutral and underlined: the accent marks only selection and "Needs you". -->
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- One setting: words on the left, the control on the right, a hairline under it. -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="0,12" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- settings.json can't be read: the same caution glyph and words as the sidebar footer, as a Fluent InfoBar. -->
        <Border x:Name="ProblemBar" DockPanel.Dock="Top" Margin="12,12,12,0" Padding="12,10" CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,12,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <Button DockPanel.Dock="Right" Content="Edit settings.json" Click="EditJson_Click" Margin="12,0,0,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock x:Name="ProblemTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProblemDetail" Style="{StaticResource Help}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Nav" Margin="8,12,4,8" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="Nav_SelectionChanged"
                     AutomationProperties.Name="Settings pages">
                <ListBoxItem Tag="General">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="General" FontSize="14" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Appearance">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="Appearance" FontSize="14" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Notifications">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="Notifications" FontSize="14" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Integrations">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="Integrations" FontSize="14" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="About">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,1,12,0" />
                        <TextBlock Text="About" FontSize="14" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16,24,24">
                <Grid MaxWidth="640" HorizontalAlignment="Left">

                    <!-- ───────── General ───────── -->
                    <StackPanel x:Name="GeneralPage">
                        <TextBlock Text="General" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="DefaultShell" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                          DisplayMemberPath="Name" SelectionChanged="Changed" AutomationProperties.Name="Default shell" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Default shell" Style="{StaticResource Label}" />
                                    <TextBlock Text="New workspaces start in it. The menu next to + opens one in any other shell." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="CtrlDSplits" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Ctrl+D splits right" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Ctrl+D splits right" Style="{StaticResource Label}" />
                                    <TextBlock Text="Turn it off to give Ctrl+D back to the terminal, where it ends input or exits. Alt+Shift+= still splits right." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="RestoreSession" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Reopen workspaces at launch" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Reopen workspaces at launch" Style="{StaticResource Label}" />
                                    <TextBlock Text="Layout, tabs and folders come back. Running programs and scrollback don't." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───────── Appearance ───────── -->
                    <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                        <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="ThemeChoice" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                          SelectionChanged="Changed" AutomationProperties.Name="Theme">
                                    <ComboBoxItem Tag="system" Content="Use Windows setting" />
                                    <ComboBoxItem Tag="dark" Content="Dark" />
                                    <ComboBoxItem Tag="light" Content="Light" />
                                </ComboBox>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Theme" Style="{StaticResource Label}" />
                                    <TextBlock Text="The window and the terminals change together." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="FontChoice" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                          SelectionChanged="Changed" AutomationProperties.Name="Terminal font" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Terminal font" Style="{StaticResource Label}" />
                                    <TextBlock Text="The monospaced fonts installed on this PC." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <ComboBox x:Name="SizeChoice" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                          SelectionChanged="Changed" AutomationProperties.Name="Text size in points" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Text size" Style="{StaticResource Label}" />
                                    <TextBlock Text="In points. Ctrl+= and Ctrl+- change one pane for now; Ctrl+0 puts it back to this." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───────── Notifications ───────── -->
                    <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
                        <TextBlock Text="Notifications" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,4"
                                   Text="Inside the window, a pane that needs you always gets the accent ring and the words “Needs you”. These settings are for when aghouse is behind other windows." />
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="Toasts" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Show a Windows notification" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Show a Windows notification" Style="{StaticResource Label}" />
                                    <TextBlock Text="With the agent's message. Clicking it goes to the pane." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <CheckBox x:Name="FlashTaskbar" DockPanel.Dock="Right" VerticalAlignment="Center" Click="Changed"
                                          AutomationProperties.Name="Flash the taskbar button" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Flash the taskbar button" Style="{StaticResource Label}" />
                                    <TextBlock Text="Until you switch back to aghouse." Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───────── Integrations ───────── -->
                    <StackPanel x:Name="IntegrationsPage" Visibility="Collapsed">
                        <TextBlock Text="Integrations" Style="{StaticResource PageTitle}" />
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button x:Name="ConnectClaude" DockPanel.Dock="Right" Content="Connect Claude Code" VerticalAlignment="Center"
                                        Click="ConnectClaude_Click" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Claude Code" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="ClaudeStatus" Style="{StaticResource Help}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="Other agents and scripts" Style="{StaticResource Label}" />
                                <TextBlock Style="{StaticResource Help}">
                                    <Run Text="From any pane, run " /><Run Text="aghouse notify --body &quot;Waiting for approval&quot;" FontFamily="Cascadia Mono, Consolas" /><Run
                                         Text=", or print an OSC 9 or OSC 777 notification. A bell marks the pane too. Scripts can also fill the sidebar with " /><Run
                                         Text="aghouse set-status" FontFamily="Cascadia Mono, Consolas" /><Run Text=", " /><Run
                                         Text="set-progress" FontFamily="Cascadia Mono, Consolas" /><Run Text=" and " /><Run
                                         Text="log" FontFamily="Cascadia Mono, Consolas" /><Run Text="." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───────── About ───────── -->
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource PageTitle}" />
                        <DockPanel Margin="0,8,0,12">
                            <Image Source="/Assets/aghouse-128.png" Width="48" Height="48" Margin="0,0,14,0" DockPanel.Dock="Left"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="aghouse logo" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="aghouse" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionLabel" Style="{StaticResource Help}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,0,0,12"
                                   Text="A Windows-native terminal workspace for running coding agents side by side." />
                        <Border Style="{StaticResource Row}" BorderThickness="0,1,0,1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Label}">
                                    <Hyperlink NavigateUri="https://github.com/pradprat/aghouse" RequestNavigate="Link_RequestNavigate">Source code on GitHub</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Label}" Margin="0,6,0,0">
                                    <Hyperlink NavigateUri="https://github.com/pradprat/aghouse/releases" RequestNavigate="Link_RequestNavigate">Releases</Hyperlink>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0"
                                           Text="aghouse doesn't check for updates. New versions are listed on the Releases page." />
                                <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0" Text="MIT License" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Open the logs folder" Click="Logs_Click" Margin="0,0,8,0" />
                            <Button Content="Edit settings.json" Click="EditJson_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
