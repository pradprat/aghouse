<local:FlyoutWindow x:Class="AgHouse.App.Surfaces.WaitingListWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AgHouse.App.Surfaces"
                    Title="aghouse waiting list" Width="380">
    <Window.Resources>
        <!-- Focus lives on the rows here, not in a search box as in the palette, so keyboard focus shows the
             neutral two-stroke ring. -->
        <Style x:Key="WaitingItem" TargetType="ListBoxItem" BasedOn="{StaticResource QuietListItem}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}" />
        </Style>
        <!-- Workspace › pane on top, the request under it, its age on the right. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:WaitingRow}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" FontSize="{DynamicResource TypeCaption}" Margin="12,1,0,0" VerticalAlignment="Top"
                           ToolTip="{Binding AgeDetail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel>
                    <TextBlock Text="{Binding Where}" FontSize="{DynamicResource TypeRow}" TextTrimming="CharacterEllipsis" Foreground="{Binding WhereBrush}" />
                    <TextBlock FontSize="{DynamicResource TypeMeta}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding Message}">
                        <Run Text="{Binding Prefix, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run
                             Text="{Binding MessageText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="8,10,8,8">
        <DockPanel Margin="10,0,6,4">
            <TextBlock x:Name="JumpHint" DockPanel.Dock="Right" Text="Ctrl+Shift+U jumps to the top one" FontSize="{DynamicResource TypeCaption}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Waiting" FontSize="{DynamicResource TypeRow}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
        <TextBlock x:Name="NothingWaiting" Text="Nothing waiting. A pane that needs you shows up here."
                   FontSize="{DynamicResource TypeMeta}" Margin="10,4,10,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ListBox x:Name="WaitingItems" BorderThickness="0" Background="Transparent" MaxHeight="300"
                 ItemContainerStyle="{StaticResource WaitingItem}" ItemTemplate="{StaticResource RowTemplate}" GotKeyboardFocus="List_GotKeyboardFocus"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 KeyDown="List_KeyDown" PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                 AutomationProperties.Name="Panes that need you" />

        <StackPanel x:Name="EarlierSection">
            <TextBlock Text="Earlier" FontSize="{DynamicResource TypeRow}" FontWeight="SemiBold" Margin="10,12,0,4"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ListBox x:Name="EarlierItems" BorderThickness="0" Background="Transparent" MaxHeight="260"
                     ItemContainerStyle="{StaticResource WaitingItem}" ItemTemplate="{StaticResource RowTemplate}" GotKeyboardFocus="List_GotKeyboardFocus"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="List_KeyDown" PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                     AutomationProperties.Name="Requests you already handled" />
        </StackPanel>
    </StackPanel>
</local:FlyoutWindow>
