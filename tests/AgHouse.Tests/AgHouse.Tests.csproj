<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgHouse.Core\AgHouse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PipeServer has no WPF dependency, so its real source is compiled into the tests instead of
         referencing the net10.0-windows App project. This lets the pipe server run without the GUI. -->
    <Compile Include="..\..\src\AgHouse.App\Ipc\PipeServer.cs" Link="Linked\PipeServer.cs" />
  </ItemGroup>

</Project>
